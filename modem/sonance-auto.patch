+// SonicVision exposes the upstream Auto rate ladder for manually matched TX/RX
+// trials. The PHY header cannot negotiate the rate used to decode itself.
+fn auto_rung(profile: Profile, rung: u8) -> Result<RateRung, JsValue> {
+    RateRung::from_wire_id(rung)
+        .filter(|_| profile == Profile::Auto)
+        .ok_or_else(|| JsValue::from_str("Invalid Sonance Auto rung"))
+}
