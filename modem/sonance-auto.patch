 /// Encode a short message into PCM samples to play out the speaker.
 #[wasm_bindgen]
-pub fn encode(profile: &str, bytes: &[u8]) -> Vec<f32> {
-    Encoder::new(profile_from_name(profile)).encode(bytes)
+pub fn encode(profile: &str, bytes: &[u8], rung: Option<u8>) -> Result<Vec<f32>, JsValue> {
+    let profile = profile_from_name(profile);
+    let encoder = if let Some(id) = rung {
+        let rung = auto_rung(profile, id)?;
+        Encoder::with_rate(profile, rung.qam, rung.code)
+    } else {
+        Encoder::new(profile)
+    };
+    Ok(encoder.encode(bytes))
 }
 
